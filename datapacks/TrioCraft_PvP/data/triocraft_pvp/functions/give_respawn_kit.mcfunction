# Base kit
give @s iron_sword 1
give @s golden_apple 3

# Lana por equipo
give @s[team=white] white_wool 64
give @s[team=orange] orange_wool 64
give @s[team=magenta] magenta_wool 64
give @s[team=light_blue] light_blue_wool 64
give @s[team=yellow] yellow_wool 64
give @s[team=lime] lime_wool 64
